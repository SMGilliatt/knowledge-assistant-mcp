# Knowledge Assistant MCP Server – example .env
# Copy to .env and fill in real values. Do not commit .env.

# Required: Google AI (Gemini) API key – https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Opik observability – https://www.comet.com/site/products/opik/
OPIK_API_KEY=
OPIK_PROJECT_NAME=knowledge-assistant

# Optional: LLM and RAG
MODEL_NAME=gemini-2.0-flash
EMBEDDING_MODEL=models/gemini-embedding-001
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=knowledge_base
RAG_TOP_K=5
